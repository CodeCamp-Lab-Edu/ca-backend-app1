### ทดสอบดูข้อมูลสินค้าทั้งหมด
GET http://localhost:3000/product


### ทดสอบดูข้อมูลสินค้าตาม ID (ตัวอย่าง id=1)
GET http://localhost:3000/product/1


### เพิ่มสินค้าตัวที่ 1
POST http://localhost:3000/product
Content-Type: application/json

{
  "name": "MacBook Pro M4",
  "price": 89000,
  "category": "Electronics",
  "image": "https://via.placeholder.com/150"
}


### เพิ่มสินค้าตัวที่ 2
POST http://localhost:3000/product
Content-Type: application/json

{
  "name": "AirPods Pro 2",
  "price": 12900,
  "category": "Accessories",
  "image": "https://via.placeholder.com/150"
}


### เพิ่มสินค้าตัวที่ 3
POST http://localhost:3000/product
Content-Type: application/json

{
  "name": "iPad Air M3",
  "price": 35900,
  "category": "Electronics",
  "image": "https://via.placeholder.com/150"
}


### ทดสอบแก้ไขสินค้า id=1
PUT http://localhost:3000/product/2
Content-Type: application/json

{
  "name": "MacBook Pro M4 Max",
  "price": 99000
}


### ทดสอบลบสินค้า id=3
DELETE http://localhost:3000/product/1


### ทดสอบค้นหาสินค้าทั้งหมด (ไม่ใส่เงื่อนไข)
GET http://localhost:3000/product/search


### ทดสอบค้นหาสินค้าด้วยคำค้นหา q
GET http://localhost:3000/product/search?q=mac


### ทดสอบค้นหาสินค้าตามหมวดหมู่
GET http://localhost:3000/product/search?category=Electronics


### ทดสอบค้นหาสินค้าตามช่วงราคา
GET http://localhost:3000/product/search?minPrice=10000&maxPrice=50000


### ทดสอบค้นหาสินค้าแบบรวมหลายเงื่อนไข
GET http://localhost:3000/product/search?q=pro&category=Accessories&minPrice=5000&maxPrice=20000&sortBy=price&sortOrder=desc&page=1&limit=5


### ทดสอบค้นหาสินค้าเรียงตามราคาน้อยไปมาก
GET http://localhost:3000/product/search?sortBy=price&sortOrder=asc


### ทดสอบค้นหาสินค้าเรียงตามราคามากไปน้อย
GET http://localhost:3000/product/search?sortBy=price&sortOrder=desc


### ทดสอบค้นหาสินค้าแบบแบ่งหน้า (page 2)
GET http://localhost:3000/product/search?limit=2&page=2


### ทดสอบค้นหาไม่เจอ
GET http://localhost:3000/product/search?q=zzzznotfound


### ทดสอบค้นหาด้วย page ไม่ถูกต้อง
GET http://localhost:3000/product/search?page=-1