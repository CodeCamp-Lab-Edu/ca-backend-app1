### ทดสอบดูข้อมูลสินค้าทั้งหมด
GET http://localhost:3000/product


### ทดสอบดูข้อมูลสินค้าตาม ID (ตัวอย่าง id=1)
GET http://localhost:3000/product/1


### เพิ่มสินค้าตัวที่ 1
POST http://localhost:3000/product
Content-Type: application/json

{
  "name": "MacBook Pro M4",
  "price": 89000,
  "category": "Electronics",
  "image": "https://via.placeholder.com/150"
}


### เพิ่มสินค้าตัวที่ 2
POST http://localhost:3000/product
Content-Type: application/json

{
  "name": "AirPods Pro 2",
  "price": 12900,
  "category": "Accessories",
  "image": "https://via.placeholder.com/150"
}


### เพิ่มสินค้าตัวที่ 3
POST http://localhost:3000/product
Content-Type: application/json

{
  "name": "iPad Air M3",
  "price": 35900,
  "category": "Electronics",
  "image": "https://via.placeholder.com/150"
}


### ทดสอบแก้ไขสินค้า id=1
PUT http://localhost:3000/product/1
Content-Type: application/json

{
  "name": "MacBook Pro M4 Max",
  "price": 99000
}


### ทดสอบลบสินค้า id=3
DELETE http://localhost:3000/product/3


### ทดสอบดูข้อมูลหมวดหมู่ทั้งหมด
GET http://localhost:3000/categories


### สมัครสมาชิกคนที่ 1
POST http://localhost:3000/user/register
Content-Type: application/json

{
  "name": "สมชาย ใจดี",
  "email": "somchai@example.com",
  "password": "123456",
  "phone": "081-234-5678",
  "age": 28
}


### สมัครสมาชิกคนที่ 2
POST http://localhost:3000/user/register
Content-Type: application/json

{
  "name": "สมหญิง รักดี",
  "email": "somying@example.com",
  "password": "abcdef",
  "phone": "082-345-6789",
  "age": 25,
  "avatar": "https://via.placeholder.com/150"
}


### ดูสมาชิกทั้งหมด
GET http://localhost:3000/user


### ดูสมาชิกตาม ID
GET http://localhost:3000/user/1